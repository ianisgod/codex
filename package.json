{
  "name": "genesis-civilization-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n engine,ui -c cyan,green \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:browser": "node scripts/browser-smoke.mjs",
    "open": "node scripts/open-local.mjs",
    "build:web": "tsc --noEmit && vite build --mode web",
    "preview:web": "vite preview --mode web --host 0.0.0.0 --port 4173",
    "test:browser:web": "node scripts/browser-web-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "playwright": "^1.51.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=24"
  }
}
